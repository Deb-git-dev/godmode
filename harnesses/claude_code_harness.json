{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "harnessName": "Claude Code",
  "agentType": "terminal-cli",
  "vendor": "Anthropic",
  "configFile": "CLAUDE.md",
  "settingsFile": ".claude/settings.json",
  "activePlugins": [
    "omniroute",
    "headroom",
    "claude-mem",
    "task-observer"
  ],
  "slashCommands": [
    "/audit",
    "/recheck",
    "/ground"
  ],
  "mcpIntegration": {
    "configPath": "mcp_config.json",
    "activeServers": [
      "supabase",
      "github",
      "gitmcp",
      "playwright",
      "canva",
      "asana",
      "headroom"
    ]
  },
  "runtime": {
    "nodeVersion": ">=22.0.0",
    "recommendedCli": "claude",
    "environmentVariables": [
      "ANTHROPIC_API_KEY",
      "OMNIROUTE_URL"
    ]
  }
}